{
  "name": "n8n-nodes-neon",
  "version": "0.1.0",
  "description": "Use Neon Postgres databases in n8n workflows.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danishaft/Neon-db-node#readme",
  "author": {
    "name": "danishaft",
    "email": "danielejeh2019@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danishaft/Neon-db-node"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/NeonApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Neon/Neon.node.js"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@n8n/node-cli": "0.41.2",
    "eslint": "9.39.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "pg-promise": "12.7.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
